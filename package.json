{
  "name": "park-fee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run clean && npm run build:web && npm run build:server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:hash": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/jwt": "10.2.2",
    "@fastify/static": "10.1.4",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "qrcode": "^1.5.4",
    "vant": "4.10.2",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "6.0.9",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
