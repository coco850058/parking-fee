# 基础运行配置
# 本文件仅作为示例。不要在这里填写真实密钥，也不要提交生产环境的 .env。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/parking.db
PUBLIC_BASE_URL=http://127.0.0.1:3000

# 登录与会话
# 生产环境请生成至少 32 字节的随机值，例如：openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
# 仅供本地开发快速登录；生产环境会忽略明文密码。
ADMIN_PASSWORD=parkfee-local-demo
# 使用 `npm run admin:hash -- "你的高强度密码"` 生成，生产环境不要配置明文密码。
ADMIN_PASSWORD_HASH=

# mock：本地开发模拟支付；wechat：真实微信支付
PAYMENT_MODE=mock

# 微信公众号（JSAPI 支付需要已认证服务号）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信支付 API v3
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
# 生产环境优先使用文件路径；PEM 文件建议放在 /etc/parkfee/wechat/，权限 0640。
WECHAT_MCH_PRIVATE_KEY_PATH=
# 仅供特殊部署方式使用。多行 PEM 不适合直接写入 systemd EnvironmentFile。
# WECHAT_MCH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
WECHAT_API_V3_KEY=

# 微信支付公钥模式。请使用商户平台下载的微信支付公钥及其公钥 ID。
WECHATPAY_PUBLIC_KEY_PATH=
# WECHATPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
WECHATPAY_PUBLIC_KEY_ID=

# 留空时由 PUBLIC_BASE_URL 生成；显式填写时必须为公网 HTTPS 地址。
# WECHAT_NOTIFY_URL=https://pay.example.com/api/wechat/pay/notify
# WECHAT_OAUTH_REDIRECT_URI=https://pay.example.com/
